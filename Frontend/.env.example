# ─── Renaissance Frontend — Environment Variables ───────────────────────────
# Salin file ini ke .env.local untuk development, atau .env.production untuk production.
# JANGAN commit .env.local / .env.production ke version control.

# URL backend Laravel (tanpa trailing slash)
VITE_API_URL=http://127.0.0.1:8000/api/v1

# API Key Gemini — gunakan key yang di-restrict domain di Google Cloud Console
# ⚠ Nilai ini akan ter-bundle ke JavaScript yang bisa dilihat di browser.
#   Untuk keamanan lebih baik, pindahkan pemanggilan Gemini ke backend Laravel.
VITE_GEMINI_API_KEY=your_gemini_api_key_here
